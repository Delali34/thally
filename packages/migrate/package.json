{
  "name": "@thallylabs/migrate",
  "version": "0.2.31",
  "description": "Shared repository and live-site migration engine for Thally",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./svg-policy": {
      "types": "./dist/svg-policy.d.ts",
      "import": "./dist/svg-policy.js",
      "default": "./dist/svg-policy.js"
    },
    "./url-migration": {
      "types": "./dist/url-migration.d.ts",
      "import": "./dist/url-migration.js",
      "default": "./dist/url-migration.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "cheerio": "1.0.0",
    "gemoji": "^8.1.0",
    "htmlparser2": "^9.1.0",
    "ignore": "^5.3.2",
    "json5": "^2.2.3",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.3",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "turndown": "^7.2.1",
    "typescript": "^5.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.5",
    "acorn": "^8.14.0",
    "tsup": "^8.0.0",
    "vitest": "^4.0.15"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thallylabs/thally.git",
    "directory": "packages/migrate"
  },
  "homepage": "https://thally.io"
}
